# ---------------------------------------------------------------------------
# Iraq Map — إعدادات البيئة
# انسخ هذا الملف إلى «.env.local» ثم عدّل القيم حسب حاجتك.
# لا ترفع «.env.local» أو أي مفاتيح حقيقية إلى Git.
# ---------------------------------------------------------------------------

# اسم التطبيق الظاهر في الواجهة
VITE_APP_NAME=Iraq Map

# --- طبقات الخريطة (Tiles) ---------------------------------------------------
# الافتراضي في القائمة: نمط CARTO Voyager الأنيق (لا يحتاج مفتاحاً).
# هذا المتغير يحدد خيار «شوارع OSM (إعداداتك)» داخل زر الطبقات.
# لأي مزوّد مدفوع ضع رابط الطبقة هنا وأضف مفتاحك في VITE_TILE_API_KEY.
# يمكن استخدام العنصر {key} داخل الرابط ليُستبدل بالمفتاح تلقائياً.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_API_KEY=
VITE_TILE_ATTRIBUTION=© مساهمو OpenStreetMap

# --- البحث والترميز الجغرافي (Geocoding) -------------------------------------
# nominatim (افتراضي، بلا مفتاح) أو photon
VITE_GEOCODER=nominatim
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- التصنيفات القريبة (Overpass API) ----------------------------------------
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- المسارات (OSRM) ---------------------------------------------------------
VITE_OSRM_URL=https://router.project-osrm.org
VITE_OSRM_CAR_PROFILE=driving
# اتركه فارغاً لاستخدام تقدير المسافة المباشرة للمشي.
# ضع foot فقط إذا كان خادم OSRM لديك يدعم ملف تعريف المشي فعلاً.
VITE_OSRM_WALK_PROFILE=

# --- عام ---------------------------------------------------------------------
# ar (افتراضي) أو en
VITE_DEFAULT_LOCALE=ar
# true لتشغيل بيانات تجريبية موسومة بوضوح عند غياب الاتصال
VITE_ENABLE_DEMO_DATA=false
VITE_APP_VERSION=0.1.0
VITE_CONTACT_EMAIL=
